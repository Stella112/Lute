# Add this site block to the VPS Caddyfile. Do not replace unrelated site blocks.
# Caddy obtains and renews the TLS certificate automatically once DNS points here.

uselute.xyz, www.uselute.xyz {
  encode gzip

  # Keep payment settlement isolated from the dashboard/API process.
  handle /v1/paid/* {
    reverse_proxy 127.0.0.1:8793
  }

  handle {
    reverse_proxy 127.0.0.1:8788
  }
}
