# Copy to deploy/.env and edit. docker compose reads it automatically.

# Base RPC that graph-node indexes from AND that the Lute verifier reads. Must be an
# ARCHIVE endpoint. The public default works but may rate-limit graph-node's polling;
# a dedicated archive RPC (Alchemy/QuickNode/etc.) is recommended for reliable syncing.
BASE_RPC_VERIFIER=https://mainnet.base.org

# Postgres password for the graph-node database (change it).
POSTGRES_PASSWORD=let-me-in

# Host-side port for graph-node's GraphQL query endpoint. Change it if 8000 is already
# taken on the host (e.g. another app). Internal container port stays 8000, so the Lute
# app (GRAPH_NODE_URL=http://graph-node:8000) is unaffected.
GRAPH_QUERY_PORT=8000

# Optional live Hedera paid verification service. Keep credentials only in this
# ignored file or a secret manager; never commit them.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
BLOCKY402_URL=https://api.testnet.blocky402.com
PAID_PUBLIC_URL=https://uselute.xyz
PAID_MAX_BLOCK_SPAN=100000
PAID_MAX_BODY_BYTES=32768
