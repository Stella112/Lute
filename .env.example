# Verifier RPC endpoint. Only the alias "BASE_RPC_VERIFIER" is ever logged; the URL
# (which may embed credentials) is never printed. Defaults to the public archive
# endpoint if unset. Must be an ARCHIVE node (eth_getLogs over historical ranges).
BASE_RPC_VERIFIER=https://mainnet.base.org

# Dashboard server port (npm run dashboard).
PORT=8788

# Optional: base URL of a Graph Node to audit with `--subgraph graphnode:<name>`
# (e.g. a target's subgraph = "graphnode:lute/steak-honest").
GRAPH_NODE_URL=http://localhost:8000

# Optional: webhook for `lute watch` alerts. Any non-VERIFIED batch posts a summary.
# Slack/generic get {text}; a URL containing "discord" gets {content}.
WEBHOOK_URL=
