# Verifier RPC endpoint. Only the alias "BASE_RPC_VERIFIER" is ever logged; the URL
# (which may embed credentials) is never printed. Defaults to the public archive
# endpoint if unset. Must be an ARCHIVE node (eth_getLogs over historical ranges).
BASE_RPC_VERIFIER=https://mainnet.base.org

# Dashboard server port (npm run dashboard).
PORT=8788
API_MAX_BODY_BYTES=1048576
# Candidate directory used by POST /v1/verifications; never accept a path from clients.
LUTE_CANDIDATE_DIR=subgraph
# Optional freshness policy for deployment gates.
LUTE_MAX_VERIFICATION_AGE_SECONDS=
# Optional persistence location for VerificationRun JSON files.
LUTE_RUNS_DIR=.lute/runs
# Opaque dashboard/MCP workflow records and generated candidates.
LUTE_WORKFLOW_DIR=.lute/workflows
# Keep false/unset. An operator must explicitly enable external Graph deployment.
LUTE_ENABLE_DEPLOYMENT=false

# Optional: base URL of a Graph Node to audit with `--subgraph graphnode:<name>`
# (e.g. a target's subgraph = "graphnode:lute/steak-honest").
GRAPH_NODE_URL=http://localhost:8000

# Optional Substreams candidate source. The package is pinned to Pinax's public
# ERC-4626 package; only the token is secret and must stay in this ignored file.
SUBSTREAMS_API_TOKEN=
SUBSTREAMS_ENDPOINT=https://base.substreams.pinax.network:443
SUBSTREAMS_PACKAGE=https://raw.githubusercontent.com/pinax-network/substreams-evm/970a665e15619de8ad7f686bd89412a1030d46dc/spkg/erc4626-v0.1.0.spkg
SUBSTREAMS_MODULE=map_events

# Optional: webhook for `lute watch` alerts. Any non-VERIFIED batch posts a summary.
# Slack/generic get {text}; a URL containing "discord" gets {content}.
WEBHOOK_URL=

# Hedera x402 v2 paid verification service (Blocky402 testnet).
# The server fetches the facilitator fee payer from GET /supported at startup.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
BLOCKY402_URL=https://api.testnet.blocky402.com
PAID_PORT=8793
# Public origin used in x402 payment requirements when behind a reverse proxy.
PAID_PUBLIC_URL=https://uselute.xyz
# Safety limits for the public paid endpoint.
PAID_MAX_BLOCK_SPAN=100000
PAID_MAX_BODY_BYTES=32768
# Optional payer account/key for the demo consumer; otherwise it creates a testnet account.
HEDERA_AGENT_ID=
HEDERA_AGENT_KEY=
